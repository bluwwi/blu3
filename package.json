{
  "name": "blu3-client",
  "version": "0.1.0",
  "description": "Blu3 — Real-time collaborative music rooms",
  "author": "Blu3",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "node scripts/generate-sw.mjs && next dev",
    "build": "node scripts/generate-sw.mjs && next build",
    "start": "next start",
    "postinstall": "node scripts/generate-sw.mjs",
    "desktop:dev": "node scripts/generate-sw.mjs && next dev & npx wait-on http://localhost:3000 && npx electron .",
    "desktop:build": "npx electron-builder --win --config",
    "desktop:publish": "npx electron-builder --win --config --publish always"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-slider": "^1.3.6",
    "@types/pako": "^2.0.4",
    "better-auth": "^1.6.14",
    "electron-updater": "^6.8.9",
    "lottie-react": "^2.4.1",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "overlayscrollbars-react": "^0.5.6",
    "pako": "^3.0.1",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tone": "15.1.22"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "electron": "^42.3.3",
    "electron-builder": "^26.15.2",
    "next-sitemap": "^4.2.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "in.blu3.desktop",
    "productName": "Blu3",
    "directories": {
      "output": "C:/Users/k4ran/OneDrive/Desktop/BLUE/dist-electron"
    },
    "files": [
      "electron/**/*"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "OWNER",
        "repo": "blu3"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "shortcutName": "Blu3"
    }
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
